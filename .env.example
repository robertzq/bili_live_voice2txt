# 复制为 .env 后填写（.env 已被 gitignore）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=bili_live_db
DB_AUTO_CREATE=1

# 可选：登录凭证来源（优先级：环境变量 > .bili_credential.json > bilicookie.txt）
# BILI_COOKIE_FILE=bilicookie.txt
# BILI_CREDENTIAL_FILE=.bili_credential.json
#
# 也可以直接写 cookie 字段：
# BILI_SESSDATA=
# BILI_JCT=
# BILI_DEDEUSERID=
# BILI_BUVID3=
# BILI_BUVID4=
# BILI_AC_TIME_VALUE=
